# 텍스트 파일은 저장소에 LF로 저장하고 체크아웃 때 OS에 맞게 변환
* text=auto

# Windows 스크립트는 항상 CRLF (cmd·PowerShell 5.1 호환)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 바이너리: 줄바꿈 변환 금지 (변환되면 파일이 깨짐)
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.woff2 binary
*.db    binary
